"click",()=>{const e=i?.classList.toggle("hidden")===!1;n.setAttribute("aria-expanded",String(e))});const t=document.getElementById("mobile-services-btn"),s=document.getElementById("mobile-services-menu");t?.addEventListener("click",()=>{const e=s?.classList.toggle("hidden")===!1;s?.classList.toggle("flex",e),t.setAttribute("aria-expanded",String(e)),t.querySelector("svg")?.classList.toggle("rotate-180",e)});</script> <main class="flex-1">    <!-- Banner hero: full-width image with overlay -->
  <section class="relative overflow-hidden text-white min-h-[calc(100svh-4rem)] md:min-h-[520px]"><!-- LCP element: one responsive <img> so the browser picks a width that
         matches the viewport, and so the preload in HeroPreload can point at
         the identical candidate list. No loading=lazy, no decoding=async. --><img src="/images/hero-banner-1280.webp" srcset="/images/hero-banner-640.webp 640w, /images/hero-banner-768.webp 768w, /images/hero-banner-960.webp 960w, /images/hero-banner-1280.webp 1280w, /images/hero-banner-1440.webp 1440w, /images/hero-banner-1600.webp 1600w, /images/hero-banner-1920.webp 1920w" sizes="100vw" alt="Abstract corporate sustainability concept" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" fetchpriority="high" width="1920" height="1072" onerror="this.style.display='none'"><!-- Fallback gradient (only visible if image fails to load) --><div class="absolute inset-0 bg-gradient-to-br from-primary via-primary-light to-accent -z-10" aria-hidden="true"></div><!-- Dark gradient overlay --><div class="absolute inset-0 bg-gradient-to-r from-primary/90 via-primary/75 to-primary/40" aria-hidden="true"></div><!-- Subtle grid overlay --><div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 80px 80px;" aria-hidden="true"></div><div class="relative max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-28"><p class="text-xs font-semibold tracking-widest uppercase mb-6 text-white/60">ESG Advisory &amp; Sustainability Consulting</p><h1 class="text-3xl lg:text-5xl font-bold leading-[1.1] tracking-tight mb-5 text-white">Integrated End-to-End Advisory</h1><p class="text-base lg:text-lg leading-relaxed mb-8 text-white/75">A Kuala Lumpur-based ESG consultancy, Ace CSR partners with corporations and investors across Malaysia and beyond to build credible, data-driven sustainability strategies, from climate risk quantification to board-ready disclosure.</p><div class="flex flex-wrap gap-4"><a href="/services/" class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-semibold rounded bg-white text-primary hover:bg-white/90 transition-all duration-200">Explore Our Services<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg></a><a href="/about/" class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-semibold rounded border border-white/40 text-white hover:border-white hover:bg-white/10 transition-all duration-200">About Us</a></div></div></section>  <section class="bg-surface" id="services"> <div class="max-w-7xl mx-auto px-6 lg:px-8 py-24"> <div class="max-w-2xl mb-14"> <p class="text-xs font-semibold tracking-widest uppercase text-secondary mb-3">What We Do</p> <h2 class="text-3xl lg:text-4xl font-bold text-primary">Integrated ESG Services</h2> <p class="mt-4 text-secondary leading-relaxed">
From strategy to disclosure, our integrated service suite helps you meet regulatory demands, satisfy investor scrutiny, and build long-term resilience.
</p> </div> <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"> <div class="group flex flex-col p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-white border-border hover:border-primary/20"> <div class="w-12 h-12 mb-6 flex items-center justify-center rounded-lg bg-surface"> <span class="text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" /></svg></span> </div> <h3 class="text-base font-semibold mb-3 text-primary"> Sustainability Reporting </h3> <p class="text-sm leading-relaxed mb-4 text-secondary"> End-to-end report production aligned with Bursa Malaysia’s sustainability reporting requirements, the National Sustainability Reporting Framework, IFRS Sustainability Disclosure Standards, FTSE Russell ESG Ratings, MSCI ESG Ratings, Morningstar Sustainalytics ESG Risk Ratings and other relevant frameworks, all managed in-house. </p> <ul class="space-y-1.5 flex-1 mb-4"> <li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Full in-house production </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Multi-framework alignment </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Visuals, diagrams &amp; layouts </li> </ul> <a href="/services/sustainability-reporting/" class="inline-flex items-center gap-2 mt-2 text-sm font-semibold transition-colors text-primary hover:text-accent"> <span>Learn More<span class="sr-only"> about Sustainability Reporting</span></span> <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path> </svg> </a> </div><div class="group flex flex-col p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-white border-border hover:border-primary/20"> <div class="w-12 h-12 mb-6 flex items-center justify-center rounded-lg bg-surface"> <span class="text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg></span> </div> <h3 class="text-base font-semibold mb-3 text-primary"> IFRS S1 &amp; S2 Advisory </h3> <p class="text-sm leading-relaxed mb-4 text-secondary"> Gap analysis, risk register development and process improvement to embed IFRS S1/S2 into operations and reporting. </p> <ul class="space-y-1.5 flex-1 mb-4"> <li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Gap analysis &amp; remediation </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Risk register development </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Embed ESG into decision-making </li> </ul> <a href="/services/ifrs-s1-s2-advisory/" class="inline-flex items-center gap-2 mt-2 text-sm font-semibold transition-colors text-primary hover:text-accent"> <span>Learn More<span class="sr-only"> about IFRS S1 &amp; S2 Advisory</span></span> <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path> </svg> </a> </div><div class="group flex flex-col p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-white border-border hover:border-primary/20"> <div class="w-12 h-12 mb-6 flex items-center justify-center rounded-lg bg-surface"> <span class="text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg></span> </div> <h3 class="text-base font-semibold mb-3 text-primary"> Climate Scenario Analysis </h3> <p class="text-sm leading-relaxed mb-4 text-secondary"> Site-level physical and transition risk quantification across unlimited locations using SSP and NGFS-aligned pathways. </p> <ul class="space-y-1.5 flex-1 mb-4"> <li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Physical &amp; transition risk assessment </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> IFRS S2-aligned reporting </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Heatmaps &amp; financial impact outputs </li> </ul> <a href="/services/climate-scenario-analysis/" class="inline-flex items-center gap-2 mt-2 text-sm font-semibold transition-colors text-primary hover:text-accent"> <span>Learn More<span class="sr-only"> about Climate Scenario Analysis</span></span> <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path> </svg> </a> </div><div class="group flex flex-col p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-white border-border hover:border-primary/20"> <div class="w-12 h-12 mb-6 flex items-center justify-center rounded-lg bg-surface"> <span class="text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg></span> </div> <h3 class="text-base font-semibold mb-3 text-primary"> Materiality Assessment </h3> <p class="text-sm leading-relaxed mb-4 text-secondary"> Double materiality surveys with unlimited stakeholder weighting, divisional segmentation and external alignment lens. </p> <ul class="space-y-1.5 flex-1 mb-4"> <li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Double materiality approach </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Confidence scoring &amp; matrix </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Reporting-ready visualisations </li> </ul> <a href="/services/materiality-assessment/" class="inline-flex items-center gap-2 mt-2 text-sm font-semibold transition-colors text-primary hover:text-accent"> <span>Learn More<span class="sr-only"> about Materiality Assessment</span></span> <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path> </svg> </a> </div><div class="group flex flex-col p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-white border-border hover:border-primary/20"> <div class="w-12 h-12 mb-6 flex items-center justify-center rounded-lg bg-surface"> <span class="text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg></span> </div> <h3 class="text-base font-semibold mb-3 text-primary"> GHG Accounting </h3> <p class="text-sm leading-relaxed mb-4 text-secondary"> Full Scope 1, 2 and 3 emissions inventory with spend-based and activity-based methodologies and auditable outputs. </p> <ul class="space-y-1.5 flex-1 mb-4"> <li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Scope 1, 2 &amp; 3 coverage </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Flexible spend &amp; activity inputs </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Auditable, standard-aligned outputs </li> </ul> <a href="/services/ghg-accounting/" class="inline-flex items-center gap-2 mt-2 text-sm font-semibold transition-colors text-primary hover:text-accent"> <span>Learn More<span class="sr-only"> about GHG Accounting</span></span> <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path> </svg> </a> </div><div class="group flex flex-col p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-white border-border hover:border-primary/20"> <div class="w-12 h-12 mb-6 flex items-center justify-center rounded-lg bg-surface"> <span class="text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" /></svg></span> </div> <h3 class="text-base font-semibold mb-3 text-primary"> Scope 3 Emissions Assessment </h3> <p class="text-sm leading-relaxed mb-4 text-secondary"> Value chain emissions screening and calculation across all 15 GHG Protocol categories, from procurement to commuting. </p> <ul class="space-y-1.5 flex-1 mb-4"> <li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Category screening &amp; relevance assessment </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Spend-based &amp; activity-based calculations </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Reporting-ready Scope 3 disclosures </li> </ul> <a href="/services/scope-3-emissions/" class="inline-flex items-center gap-2 mt-2 text-sm font-semibold transition-colors text-primary hover:text-accent"> <span>Learn More<span class="sr-only"> about Scope 3 Emissions Assessment</span></span> <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path> </svg> </a> </div><div class="group flex flex-col p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-white border-border hover:border-primary/20"> <div class="w-12 h-12 mb-6 flex items-center justify-center rounded-lg bg-surface"> <span class="text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" /></svg></span> </div> <h3 class="text-base font-semibold mb-3 text-primary"> ESG &amp; Sustainability Training </h3> <p class="text-sm leading-relaxed mb-4 text-secondary"> Customised ESG, climate and Scope 3 training for boards, management teams, data owners and reporting teams. </p> <ul class="space-y-1.5 flex-1 mb-4"> <li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Board &amp; management ESG training </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Climate &amp; scenario analysis workshops </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Scope 3 data owner briefings </li> </ul> <a href="/services/esg-sustainability-training/" class="inline-flex items-center gap-2 mt-2 text-sm font-semibold transition-colors text-primary hover:text-accent"> <span>Learn More<span class="sr-only"> about ESG &amp; Sustainability Training</span></span> <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path> </svg> </a> </div><div class="group flex flex-col p-8 rounded-lg border transition-all duration-300 hover:shadow-xl hover:-translate-y-1 bg-white border-border hover:border-primary/20"> <div class="w-12 h-12 mb-6 flex items-center justify-center rounded-lg bg-surface"> <span class="text-primary" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z" /></svg></span> </div> <h3 class="text-base font-semibold mb-3 text-primary"> ESG Framework Support </h3> <p class="text-sm leading-relaxed mb-4 text-secondary"> Practical guidance on ESG questionnaires, ratings submissions, and platform reporting for FTSE4Good, MSCI, Sustainalytics and more. </p> <ul class="space-y-1.5 flex-1 mb-4"> <li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Ratings &amp; questionnaire support </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> FTSE4Good, MSCI, Sustainalytics </li><li class="flex items-start gap-2 text-xs text-secondary"> <span class="mt-1.5 w-1 h-1 rounded-full shrink-0 bg-primary"></span> Framework-to-strategy integration </li> </ul> <a href="/services/esg-framework-support/" class="inline-flex items-center gap-2 mt-2 text-sm font-semibold transition-colors text-primary hover:text-accent"> <span>Learn More<span class="sr-only"> about ESG Framework Support</span></span> <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path> </svg> </a> </div> </div> <div class="mt-10 text-center"> <a href="/services/" class="inline-flex items-center gap-2 text-primary font-semibold text-sm hover:text-accent transition-colors">
