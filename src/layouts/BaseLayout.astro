---
import '../styles/global.css';
import '../styles/redesign.css';
import { withBase } from '../lib/content';
import { Image } from 'astro:assets';
import readingCat from '../assets/reading-cat.png';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = '文学猫档案',
  description = '认识文学作品里的猫。',
  image,
} = Astro.props;
const pageTitle = title === '文学猫档案' ? title : `${title}｜文学猫档案`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="theme-color" content="#f2be22" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <a class="archive-mark" href={withBase()}>文学猫档案</a>
      <p class="site-slogan">认识文学作品里的猫。</p>
      <nav aria-label="主要导航">
        <a href={`${withBase()}#archive`}>浏览猫角色</a>
        <a href={`${withBase()}#about`}>关于档案</a>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-cat" aria-hidden="true">
        <Image src={readingCat} alt="" width={240} format="webp" loading="lazy" />
      </div>
      <div class="footer-colophon">
        <p>A daily literary cat archive</p>
        <p>by <a class="footer-brewing" href="https://www.denkibrew.com/"><span aria-hidden="true">🍺</span> Dennki Brewing</a></p>
        <a class="footer-source" href="https://github.com/Noctsyndrome/literary-cats">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
  </body>
</html>
